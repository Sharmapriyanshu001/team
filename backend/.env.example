# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed.

PORT=5000

# Workspace previews listen here, on an origin of their own. Keeping them off
# the API's origin is what lets a previewed app use localStorage without ever
# being able to read the panel's. Defaults to PORT + 1.
PREVIEW_PORT=5001

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Signing key for every panel's JWT. Generate a fresh one per environment with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start if this is missing, too short, or left as the
# placeholder below — a guessable key lets anyone mint a token for any role.
JWT_SECRET=replace_me_with_a_generated_secret

# Seed account used by seedAdmin.js / seedData.js
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# ------------------------------------------------------------------ hardening

# Which browser origins may call this API, comma separated, no trailing slash.
# Required in production — the server refuses to start without it when
# NODE_ENV=production. Left empty in development it allows the Vite dev server.
CORS_ORIGINS=https://panel.example.com

# How many reverse proxies sit in front of this server. 1 for a single nginx.
# Without it every request looks like it came from 127.0.0.1 and the whole
# internet shares one rate-limit bucket. Leave unset when running directly.
TRUST_PROXY=1

# Switches on combined request logging and the strict CORS requirement above.
NODE_ENV=production

# ---------------------------------------------------------------- the vault

# Encrypts every credential stored in the vault (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Kept separate from JWT_SECRET on purpose: they protect different things and
# leak through different holes. Sharing one value means one leak costs both.
#
# LOSING THIS MEANS LOSING EVERY SECRET IN THE VAULT — there is no recovery, by
# design. Back it up somewhere that is not this server. Leave it unset and the
# vault simply refuses to work; nothing is ever stored unencrypted.
VAULT_KEY=
