# ---------------------------------------------------------------- secrets
# Never commit real credentials. .env.example carries the shape instead.
.env
.env.*
!.env.example

# ------------------------------------------------------------ dependencies
node_modules/

# ----------------------------------------------------------------- builds
dist/
build/

# ------------------------------------------------------------- user uploads
# Uploaded archives and extracted workspaces are project data, not source.
backend/uploads/*
!backend/uploads/.gitkeep

# ------------------------------------------------------------------- logs
*.log
npm-debug.log*
logs/

# -------------------------------------------------------- editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ------------------------------------------------------------- scratch work
# One-off diagnostic scripts follow this prefix so they never land in a commit.
_*.js
